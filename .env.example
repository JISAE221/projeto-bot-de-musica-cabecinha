# ============================================
# CABECINHA BOT — exemplo de variáveis
# Copia esse arquivo pra .env e preenche
# ============================================

# ---------- Discord ----------
# Token do bot: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=cole_seu_token_aqui
# Client ID da aplicação (usado pra slash commands no futuro)
DISCORD_CLIENT_ID=
# Prefixo dos comandos de texto (~play, ~stop, etc)
COMMAND_PREFIX=~

# ---------- Runtime ----------
NODE_ENV=development
LOG_LEVEL=debug

# ---------- Spotify (opcional, pra integração futura) ----------
# Cria um app em https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/callback/spotify

# ---------- Persistência (opcional, pra fila/playlist/stats) ----------
DATABASE_URL=postgresql://user:pass@localhost:5432/cabecinha
REDIS_URL=redis://localhost:6379

# ---------- Visualizer / Web (opcional) ----------
WEB_PORT=3000
